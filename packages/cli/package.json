    "codex",
    "agents-md",
    "project-memory",
    "knowledge-registry",
    "cli"
  ],
  "license": "MIT",
  "author": "klev-o",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klev-o/context-tend.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/klev-o/context-tend#readme",
  "bugs": {
    "url": "https://github.com/klev-o/context-tend/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
